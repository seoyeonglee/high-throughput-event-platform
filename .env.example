APP_NAME=high-throughput-event-platform
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/events
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=events
REDIS_CONSUMER_GROUP=event-workers
REDIS_DLQ_STREAM=events-dlq
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
WORKER_BATCH_SIZE=100
WORKER_BLOCK_MS=5000
WORKER_MAX_RETRIES=3
WORKER_CLAIM_IDLE_MS=60000
